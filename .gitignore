# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── 가상환경 ──────────────────────────────────────────────────────────────
.venv/
.venv-1/
venv/
env/

# ── 데이터 (대용량 / 원본은 git에 올리지 않음) ─────────────────────────────
data/
*.csv
*.xlsx
*.parquet

# ── 학습된 모델 / 파이프라인 캐시 (재현 시 재생성) ─────────────────────────
app/cache/
*.pkl
*.joblib
catboost_info/

# ── 로그 / 임시 ───────────────────────────────────────────────────────────
*.log
.tmp/
uvicorn.log

# ── 비밀키 ────────────────────────────────────────────────────────────────
.env
*.key

# ── OS / 에디터 ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
~$*

# ── 대용량 바이너리 (보고서 PDF는 docs/ 예외 허용) ─────────────────────────
ppt.pdf
*.hwp

# docs/ 안의 기준 보고서 PDF는 추적 (아래 예외)
!docs/*.pdf
